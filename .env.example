# Local development only. In Coolify set these in the application's Environment Variables.
ADMIN_PASSWORD=change-me
MT5_MOCK=true            # synthetic broker, no real connection
# BROKER=ctrader         # ctrader | mt5
# CTRADER_CLIENT_ID=
# CTRADER_CLIENT_SECRET=
# CTRADER_ENV=demo       # demo | live
ANTHROPIC_API_KEY=
FREELLMAPI_BASE_URL=
FREELLMAPI_KEY=
FRED_API_KEY=
